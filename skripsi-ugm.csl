<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="id-ID">
  <!-- Gaya sitasi numerik mengikuti Template Skripsi 2023/2025 DTNTF UGM:
         [n] / [2-4, 6, 10]; urutan = kemunculan di naskah.
         Penulis: inisial depan + nama belakang ("G. R. Sunaryo"), semua penulis ditulis, "dan" sebelum penulis terakhir.
         Buku/laporan/web : Penulis. *Judul*. Kota, Penerbit, Tahun.
         Artikel jurnal   : Penulis. "Judul" *Jurnal*, vol. X, no. Y, pp. a-b, Tahun.
         Prosiding        : Penulis. *Judul*. Kota, Nama Seminar, Tahun.
         Web              : Penulis. *Judul*. Diakses dari URL, tanggal akses. -->
  <info>
    <title>Skripsi DTNTF UGM 2023/2025 (numerik)</title>
    <id>http://www.zotero.org/styles/skripsi-dtntf-ugm-2023</id>
    <link href="http://www.zotero.org/styles/skripsi-dtntf-ugm-2023" rel="self"/>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Numerik [n], inisial penulis, format blok sesuai templat DTNTF UGM 2023/2025</summary>
    <updated>2026-10-15T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="id">
    <style-options punctuation-in-quote="false"/>
    <terms>
      <term name="page-range-delimiter">-</term>
      <term name="citation-range-delimiter">-</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never"
            initialize="true" initialize-with=". "/>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="pubinfo">
    <!-- Kota, Penerbit, Tahun (buku, laporan, skripsi, dll.) -->
    <group delimiter=", ">
      <text variable="genre"/>
      <text variable="publisher-place"/>
      <text variable="publisher"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="rest">
    <choose>
      <!-- Artikel jurnal: "Judul" Jurnal, vol. 39, no. 4, pp. 695-723, 2015 -->
      <if type="article-journal" match="any">
        <group delimiter=" ">
          <text variable="title" quotes="true"/>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <group delimiter=" ">
              <text value="vol."/>
              <text variable="volume"/>
            </group>
            <group delimiter=" ">
              <text value="no."/>
              <text variable="issue"/>
            </group>
            <group delimiter=" ">
              <text value="pp."/>
              <text variable="page"/>
            </group>
            <text macro="year"/>
          </group>
        </group>
      </if>
      <!-- Prosiding: Judul. Kota, Nama Seminar, Tahun -->
      <else-if type="paper-conference" match="any">
        <group delimiter=". ">
          <text variable="title" font-style="italic"/>
          <group delimiter=", ">
            <text variable="event-place"/>
            <text variable="publisher-place"/>
            <text variable="container-title"/>
            <text macro="year"/>
          </group>
        </group>
      </else-if>
      <!-- Surat kabar / majalah -->
      <else-if type="article-magazine article-newspaper" match="any">
        <group delimiter=" ">
          <text variable="title" quotes="true"/>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <group delimiter=" ">
              <text value="hal."/>
              <text variable="page"/>
            </group>
            <date variable="issued" form="text"/>
          </group>
        </group>
      </else-if>
      <!-- Internet: Judul. Diakses dari URL, tanggal -->
      <else-if type="webpage post-weblog" match="any">
        <group delimiter=". ">
          <text variable="title" font-style="italic"/>
          <group delimiter=", ">
            <group delimiter=" ">
              <text value="Diakses dari"/>
              <text variable="URL"/>
            </group>
            <date variable="accessed" form="text"/>
          </group>
        </group>
      </else-if>
      <!-- Komunikasi pribadi -->
      <else-if type="personal_communication" match="any">
        <date variable="issued" form="text"/>
      </else-if>
      <!-- Buku, laporan, skripsi/tesis, lainnya: Judul. Kota, Penerbit, Tahun -->
      <else>
        <group delimiter=". ">
          <text variable="title" font-style="italic"/>
          <text macro="pubinfo"/>
        </group>
      </else>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="1" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="rest"/>
      </group>
    </layout>
  </bibliography>
</style>
